# PodSnippet Studio Environment Variables

# Backend Port
PORT=5000

# ElevenLabs API Key (Get yours from https://elevenlabs.io or Hacktoberfest partner perks)
ELEVENLABS_API_KEY=

# Open-Weight LLM (Google Gemma 2 API or HuggingFace / OpenRouter / Ollama)
# Optional: PodSnippet Studio includes a robust built-in heuristic & mock engine if keys are not provided
GEMMA_API_KEY=
GEMMA_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemma-2-9b-it:generateContent
